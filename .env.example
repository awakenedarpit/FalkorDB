# Gemini — server-side only; never prefix this key with NEXT_PUBLIC_.
# Used for chat, image OCR/description, and scanned-PDF extraction.
GEMINI_API_KEY=
# Optional model overrides; set these to identifiers enabled for your Gemini account.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-flash-lite-latest
# Optional; use a stable random value in production. Falls back to GEMINI_API_KEY when omitted.
UPLOAD_TOKEN_SECRET=

# FalkorDB
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=memory_agent
